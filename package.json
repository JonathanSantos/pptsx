{
  "name": "pptsx-monorepo",
  "private": true,
  "description": "Monorepo do pptsx: o núcleo (packages/pptsx) e os pacotes de design system (@pptsx/ds-kit, @pptsx/ds-base).",
  "type": "module",
  "workspaces": [
    "packages/pptsx",
    "packages/ds-kit",
    "packages/ds-base"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint:repo": "npm run lint:repo --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test:package": "npm run test:package --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "pptxgenjs": {
      "image-size": "^2.0.4"
    }
  }
}
