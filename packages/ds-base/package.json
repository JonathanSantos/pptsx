{
  "name": "@pptsx/ds-base",
  "version": "0.1.0",
  "description": "Design system de exemplo sobre o pptsx: tokens, tema, layouts, componentes, regras de marca e galeria.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "guide/*.md",
    "fonts/inter/*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "THIRD_PARTY.md"
  ],
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit -p .",
    "lint:repo": "tsc --noEmit -p . --noUnusedLocals --noUnusedParameters",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "schema": "tsx tools/schema.ts",
    "test:package": "vitest run tests/package --config vitest.package.config.ts"
  },
  "peerDependencies": {
    "pptsx": ">=0.7.0",
    "@pptsx/ds-kit": ">=0.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.6.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
