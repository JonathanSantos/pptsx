{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "jsxImportSource": "pptsx",
    "paths": {
      "pptsx": ["./src/index.ts"],
      "pptsx/jsx-runtime": ["./src/jsx/jsx-runtime.ts"],
      "pptsx/jsx-dev-runtime": ["./src/jsx/jsx-dev-runtime.ts"]
    }
  },
  "include": ["src", "tests", "examples", "tools/standalone", "vitest.config.ts", "vitest.package.config.ts", "vitest.standalone.config.ts"]
}
